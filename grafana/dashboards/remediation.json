            },
            {
              "selector": "state",
              "text": "State",
              "type": "string"
            },
            {
              "selector": "session_id",
              "text": "Session",
              "type": "string"
            },
            {
              "selector": "verdict",
              "text": "Verdict",
              "type": "string"
            },
            {
              "selector": "pull_request",
