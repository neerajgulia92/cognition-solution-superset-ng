    {
      "type": "stat",
      "title": "Session outcomes",
      "description": "Sessions run, how many reached an answer without a human, and how many merged fixes a re-scan proved.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
