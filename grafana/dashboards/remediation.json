    {
      "type": "table",
      "title": "Funnel",
      "description": "How many findings reached each stage. Drop-off between rows is work that stalled.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
