# Copy to .env and fill in. Never commit the result.

# A GitHub token with `repo` scope on the target repository. Needs write
# access to issues, and to pull requests if AUTO_MERGE is on.
GITHUB_TOKEN=

# From https://app.devin.ai/settings/api-keys. Only the dispatch and poll
# stages use it; scan, sync and metrics work without it.
DEVIN_API_KEY=

# The repository being scanned and remediated.
TARGET_REPOSITORY=neerajgulia92/superset-ng
TARGET_REF=master
BASE_BRANCH=master

# Scheduled run, UTC. Set to `off` for manual runs only.
PIPELINE_CRON=0 * * * *

# How many already-filed findings each scan queues for remediation, and how
# many Devin sessions a dispatch may start. Keep both small: one session per
# finding is real spend.
QUEUE_UNTRIAGED=1
MAX_SESSIONS=1

# Merge remediation pull requests once every check passes.
AUTO_MERGE=true

# Close findings the scan no longer reproduces. Off by default: this stack
# scans Python dependencies and code but not npm, so an npm finding filed by
# the CI scanner would look resolved here and be closed for the wrong reason.
CLOSE_RESOLVED=false

# Walk the pipeline without writing to GitHub or starting a session.
DRY_RUN=false

GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
CONTROL_PORT=8000
